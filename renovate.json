{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":label('renovatebot')",
    ":enableVulnerabilityAlertsWithLabel('renovatebot/security')",
    ":semanticCommits",
    ":automergePatch",
    ":automergeTesters",
    ":automergeLinters"
  ],
  "packageRules": [
    {
      "matchJsonata": [
        "$match(depName,/^@graphql-mesh/)"
      ],
      "groupName": "graphql-mesh"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}