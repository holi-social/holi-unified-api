backendUrl() {
  LOCAL_ENABLED=$1
  LOCAL=$2
  REMOTE=$3
  if [ "$LOCAL_ENABLED" = "true" ]; then
    echo $LOCAL
  else
    echo $REMOTE
  fi
}

